{
    "name": "docx-validate",
    "version": "0.52.0",
    "description": "OOXML validators and redline/comment helpers for .docx and .pptx files. XSD-backed, TypeScript, ESM, for the neurotic developer.",
    "homepage": "https://github.com/jandira-tech/docx-validate#readme",
    "bugs": {
        "url": "https://github.com/jandira-tech/docx-validate/issues"
    },
    "license": "Apache-2.0",
    "author": "Arthur Souza Rodrigues <arthur@jandira.tech>",
    "keywords": [
        "docx",
        "pptx",
        "ooxml",
        "openxml",
        "office",
        "word",
        "powerpoint",
        "validate",
        "validator",
        "validation",
        "xsd",
        "schema",
        "redline",
        "comments",
        "typescript"
    ],
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jandira-tech/docx-validate.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "types": "./dist/index.d.mts",
    "attw": {
        "profile": "esm-only"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "test": "vitest",
        "test:strict": "vitest run tests/fixtures-all-strict.test.ts",
        "test:lenient": "vitest run tests/fixtures-all-lenient.test.ts",
        "test:fixtures:refresh": "tsx scripts/probe-all-fixtures.ts",
        "test:fixtures:word": "tsx scripts/probe-word-fixtures.ts",
        "test:fixtures:regenerate-word-invalid": "tsx scripts/regenerate-word-invalid-fixtures.ts",
        "vp": "vitest",
        "check": "vp check",
        "check:tsgo": "tsgo --noEmit",
        "lint": "oxlint --type-aware --type-check",
        "lint:fix": "oxlint --type-aware --type-check --fix",
        "fmt": "vp fmt --check",
        "fmt:fix": "vp fmt",
        "cspell": "cspell \"{src,tests}/**/*.{ts,md}\" && cspell \"./*.*\"",
        "docs": "typedoc src/index.ts --tsconfig tsconfig.typedoc.json",
        "release": "tsx scripts/release.ts",
        "release:publish": "git push --follow-tags && npm publish --access public",
        "prepublishOnly": "vp run build"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@types/node": "^26.6.4",
        "@types/tmp": "^0.2.6",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitest/coverage-v8": "^5.0.3",
        "bumpp": "^12.3.0",
        "cspell": "^10.3.6",
        "eslint-plugin-functional": "^10.0.1",
        "eslint-plugin-jsdoc": "^65.1.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "publint": "^0.3.25",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "vite-plus": "^1.0.0",
        "vitest": "^5.0.3"
    },
    "packageManager": "pnpm@12.8.2",
    "dependencies": {
        "@xmldom/xmldom": "^0.9.12",
        "commander": "^15.0.0",
        "jszip": "^3.10.2",
        "libxml2-wasm": "^0.7.2",
        "tmp": "^0.2.7",
        "xpath": "^0.0.34"
    }
}
