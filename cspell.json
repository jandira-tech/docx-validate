{
    "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
    "version": "0.2",
    "language": "en",
    "files": [
        "src/**/*.{ts,tsx,js,mjs,cjs,json,md}",
        "tests/**/*.{ts,tsx,js,mjs,cjs}",
        "*.{ts,js,json,md}"
    ],
    "ignorePaths": [
        "node_modules/**",
        "dist/**",
        "build/**",
        "coverage/**",
        "bun.lock",
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.docx",
        "*.xlsx",
        "*.pdf",
        "docx/**",
        "docx-templates/**",
        ".git/**",
        ".DS_Store"
    ],
